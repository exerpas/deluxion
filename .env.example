# Contraseña maestra del panel /admin (OBLIGATORIA, usa algo largo y aleatorio)
ADMIN_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
# Opcional: orígenes permitidos por CORS separados por coma (vacío = solo mismo origen)
CORS_ORIGIN=
# Opcional: carpeta donde se guarda keys.json (en Render: ruta del Persistent Disk, ej. /var/data)
DATA_DIR=
